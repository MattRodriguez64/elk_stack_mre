{
  "index_patterns": ["nginx-access-lab"],
  "priority": 200,
  "_meta": {
    "description": "Mapping des métriques du site Miam&Go, installé par Logstash (voir logstash.conf).",
    "client.geo.location": "geo_point : carte des commandes par établissement dans Kibana Maps",
    "client.geo.city_name / country_name": "ville et pays de l'établissement",
    "url.path": "pages les plus vues / endpoints appelés, sans les paramètres",
    "params.*": "paramètres d'URL découpés par le filtre kv de Logstash (sid, resto, plat, duree, total...)"
  },
  "template": {
    "mappings": {
      "properties": {
        "client": {
          "properties": {
            "geo": {
              "properties": {
                "location": { "type": "geo_point" },
                "name": { "type": "keyword" },
                "city_name": { "type": "keyword" },
                "country_name": { "type": "keyword" }
              }
            }
          }
        },
        "url": {
          "properties": {
            "path": { "type": "keyword" },
            "query": { "type": "keyword", "ignore_above": 1024 }
          }
        },
        "params": {
          "properties": {
            "sid": { "type": "keyword" },
            "page": { "type": "keyword" },
            "duree": { "type": "integer" },
            "resto": { "type": "keyword" },
            "ville": { "type": "keyword" },
            "pays": { "type": "keyword" },
            "plat": { "type": "keyword" },
            "prix": { "type": "float" },
            "qte": { "type": "integer" },
            "raison": { "type": "keyword" },
            "q": { "type": "keyword" },
            "cat": { "type": "keyword" },
            "tri": { "type": "keyword" },
            "commande": { "type": "keyword" },
            "articles": { "type": "integer" },
            "sous_total": { "type": "float" },
            "total": { "type": "float" },
            "zone": { "type": "keyword" },
            "lat": { "type": "float" },
            "lon": { "type": "float" },
            "creneau": { "type": "keyword" },
            "paiement": { "type": "keyword" },
            "pourboire": { "type": "float" },
            "promo": { "type": "keyword" },
            "etape": { "type": "keyword" },
            "note": { "type": "integer" }
          }
        }
      }
    }
  }
}
